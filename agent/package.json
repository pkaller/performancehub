{
  "name": "performancehub-agent",
  "version": "1.0.0",
  "description": "PerformanceHub local agent — runs on your LAN, scans for devices, and relays to the PerformanceHub website over a secure outbound connection.",
  "type": "commonjs",
  "bin": "agent.js",
  "main": "agent.js",
  "scripts": {
    "start": "node agent.js",
    "build": "pkg . --out-path dist"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bonjour-service": "^1.2.1",
    "castv2-client": "^1.2.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.3.0"
  },
  "overrides": {
    "protobufjs": "^7.6.5"
  },
  "pkg": {
    "scripts": ["scanner.js", "devices.js", "oui.js"],
    "assets": ["node_modules/castv2/lib/cast_channel.proto"],
    "targets": [
      "node20-linux-x64",
      "node20-macos-x64",
      "node20-macos-arm64",
      "node20-win-x64"
    ],
    "outputPath": "dist"
  }
}
