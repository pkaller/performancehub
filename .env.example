# Example env for the CLOUD site (cloud/.env for local dev; on Render these are
# set in the dashboard / render.yaml).

# --- Google OAuth ---
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# --- Access control ---
# Comma-separated Google account emails allowed to sign in. Leave blank to allow
# any Google account (NOT recommended).
ALLOWED_EMAILS=you@gmail.com

# --- Server ---
PORT=3000
# Public URL of the site; must match the Google OAuth redirect URI base.
BASE_URL=http://localhost:3000
# Signs session cookies. Long random string.
SESSION_SECRET=change-me
# Signs agent pairing tokens. Long random string (different from SESSION_SECRET).
RELAY_SECRET=change-me-too
# Set "true" when served over HTTPS (Render sets this via render.yaml).
COOKIE_SECURE=false

# --- Download page ---
# GitHub repo whose Releases host the agent binaries.
GITHUB_REPO=pkaller/performancehub
