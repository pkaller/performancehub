# Copy this file to ".env" and fill in your values.

# --- Google OAuth ---
# Create credentials at https://console.cloud.google.com/apis/credentials
# Application type: "Web application"
# Authorized redirect URI: http://localhost:3000/auth/google/callback
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# --- Access control ---
# Comma-separated list of Google account emails allowed to sign in.
# Anyone who successfully logs in with Google but is NOT on this list is rejected.
# Leave blank to allow ANY Google account (NOT recommended — this controls your LAN).
ALLOWED_EMAILS=you@gmail.com

# --- Server ---
PORT=3000
# Must match the host+port you actually browse to and the OAuth redirect URI above.
BASE_URL=http://localhost:3000
# Secret used to sign session cookies. Set to a long random string in production.
SESSION_SECRET=change-me-to-a-long-random-string

# --- Scanner (optional tuning) ---
# CIDR to scan, e.g. 192.168.1.0/24. Leave blank to auto-detect from your network interface.
SCAN_CIDR=
# Seconds to browse mDNS/Bonjour during a scan.
MDNS_SECONDS=4
