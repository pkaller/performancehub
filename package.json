{
  "name": "performancehub",
  "version": "1.0.0",
  "description": "Local network device dashboard with Google login. Scans your LAN, lists devices, and exposes per-device actions (volume, video feed, web UI, etc.).",
  "type": "commonjs",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bonjour-service": "^1.2.1",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-session": "^1.18.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0"
  }
}
